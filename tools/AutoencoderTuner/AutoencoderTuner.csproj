<Project Sdk="Microsoft.NET.Sdk">

    <!-- Tunes the autoencoder generator's models (latent statistics, baked filters) and previews its output. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../VoxelMap.cs" Link="Mod/VoxelMap.cs"/>
        <Compile Include="../../MapVoxelReader.cs" Link="Mod/MapVoxelReader.cs"/>
        <Compile Include="../../TerrainTools/Surface.cs" Link="Mod/TerrainTools/Surface.cs"/>
        <Compile Include="../../Generators/Autoencoder/*.cs" Link="Mod/Generators/Autoencoder/%(Filename)%(Extension)"/>
        <Compile Include="../TerrainPreview/Image.cs" Link="Preview/Image.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NumSharp" Version="0.30.0"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    </ItemGroup>
</Project>
