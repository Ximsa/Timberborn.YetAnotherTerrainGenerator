<Project Sdk="Microsoft.NET.Sdk">

    <!-- Tunes the autoencoder generator's models (latent statistics, baked filters) and previews its output. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="../TerrainPreview/Image.cs" Link="Preview/Image.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NumSharp" Version="0.30.0"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    </ItemGroup>
</Project>
