<Project Sdk="Microsoft.NET.Sdk">

    <!-- Runs the mod's terrain generators outside the game and renders preview images. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../VoxelMap.cs" Link="Mod/VoxelMap.cs"/>
        <Compile Include="../../MapVoxelReader.cs" Link="Mod/MapVoxelReader.cs"/>
        <Compile Include="../../Generators/**/*.cs" Link="Mod/Generators/%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="../../TerrainTools/**/*.cs" Link="Mod/TerrainTools/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NumSharp" Version="0.30.0"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    </ItemGroup>
</Project>
