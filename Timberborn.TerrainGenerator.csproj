<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <TimberbornDir>F:\GOG\Timberborn</TimberbornDir>
        <TimberbornManagedDir>$(TimberbornDir)\Timberborn_Data\Managed</TimberbornManagedDir>
        <TimberbornModsDir>C:\Users\monik\OneDrive\Dokumente\Timberborn\Mods</TimberbornModsDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="$(TimberbornManagedDir)\T*.dll" Private="false" Publicize="true"/>
        <Reference Include="$(TimberbornManagedDir)\U*.dll" Private="false"/>
        <Reference Include="$(TimberbornManagedDir)\B*.dll" Private="false"/>
        <Reference Include="$(TimberbornManagedDir)\System.Collections.Immutable.dll" Private="false"/>
        <Reference Include="$(TimberbornManagedDir)\Newtonsoft.Json.dll" Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(TimberbornModsDir)\Harmony\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="TimberUi">
            <HintPath>$(TimberbornModsDir)\timberui-1y6n\version-1.1\TimberUi.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <!-- offline tools (e.g. the terrain preview renderer) are separate projects -->
        <Compile Remove="tools/**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NumSharp" Version="0.30.0"/>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all"/>
    </ItemGroup>

    <!-- After every build, copy the mod into release/ and into the game's Mods folder, which the game loads it from.
         manifest.json and Imports/ are not tracked and stay as they are. Build with -p:DeployMod=false to skip. -->
    <PropertyGroup>
        <DeployMod Condition="'$(DeployMod)' == ''">true</DeployMod>
        <ModVersionFolder>version-1.1</ModVersionFolder>
    </PropertyGroup>

    <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
        <ItemGroup>
            <_ModRoot Include="$(MSBuildProjectDirectory)\release"/>
            <_ModRoot Include="$(TimberbornModsDir)\TerrainGen" Condition="Exists('$(TimberbornModsDir)')"/>
            <_ModLocalization Include="Localizations\*.csv"/>
            <_ModSprite Include="Sprites\*.png"/>
            <_ModToolGroup Include="ToolGroups\*.json"/>
            <_ModModel Include="Models\*"/>
        </ItemGroup>
        <!-- a running game locks the DLL; warn instead of failing the build -->
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="%(_ModRoot.Identity)\$(ModVersionFolder)"
              SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue"/>
        <Copy SourceFiles="@(_ModLocalization)" DestinationFolder="%(_ModRoot.Identity)\$(ModVersionFolder)\Localizations"
              SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue"/>
        <Copy SourceFiles="@(_ModSprite)" DestinationFolder="%(_ModRoot.Identity)\$(ModVersionFolder)\Sprites"
              SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue"/>
        <Copy SourceFiles="@(_ModToolGroup)" DestinationFolder="%(_ModRoot.Identity)\$(ModVersionFolder)\ToolGroups"
              SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue"/>
        <Copy SourceFiles="@(_ModModel)" DestinationFolder="%(_ModRoot.Identity)\Models"
              SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue"/>
        <Message Importance="high" Text="Deployed the mod to %(_ModRoot.Identity)"/>
    </Target>
</Project>
